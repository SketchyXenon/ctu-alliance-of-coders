# Alliance of Coders - environment variable template.
# Copy to .env and fill in real values. Never commit .env.
# Per 06-security-architecture.md section 8: secrets stay out of source control.

# --- Required ---
# SQLite (dev): file:./db/custom.db  (relative to the directory the dev server is started in - typically the project root)
# Postgres (prod): see DIRECT_URL below for Supabase pooled connections
DATABASE_URL="file:./db/custom.db"

# --- Required for Supabase / Postgres production ---
# Supabase provides THREE connection endpoints. You need TWO of them:
#
# 1. DATABASE_URL = TRANSACTION MODE POOLER (port 6543) for the app runtime.
#    IPv4-accessible. PgBouncer transaction mode pools connections for serverless.
#    Does NOT support DDL (can't run prisma db push / migrate through it).
#    Format: postgresql://postgres.REF:PASS@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# 2. DIRECT_URL = SESSION MODE POOLER (port 5432, SAME pooler host) for migrations.
#    IPv4-accessible. PgBouncer session mode supports DDL — prisma db push works.
#    Format: postgresql://postgres.REF:PASS@aws-REGION.pooler.supabase.com:5432/postgres
#
#    DO NOT use the "Direct connection" URL (db.REF.supabase.co:5432) — it is
#    IPv6-ONLY and unreachable from most IPv4 networks (causes P1001 hang/error).
#
# Both URLs use the SAME pooler host (aws-REGION.pooler.supabase.com), just
# different ports: 6543 for runtime (transaction mode), 5432 for migrations
# (session mode). The username for both is "postgres.REF" (not just "postgres").
#
# Example (replace REF, PASS, REGION with your Supabase values):
# DATABASE_URL="postgresql://postgres.REF:PASS@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.REF:PASS@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
#
# For SQLite dev: leave DIRECT_URL unset (Prisma falls back to DATABASE_URL).
# DIRECT_URL=""

# --- Optional: public site config (safe to expose to client) ---
# Canonical site URL (no trailing slash). Used for SEO metadata, JSON-LD, OG tags.
NEXT_PUBLIC_SITE_URL="https://allianceofcoders.ph"
# Social links - leave empty to hide the link from the footer (no hardcoded fallbacks).
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_CONTACT_EMAIL="allianceofcoders@ctu.edu.ph"

# --- Optional: Supabase (required in production for image storage) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only - never prefixed with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional: security tuning ---
# Comma-separated extra origins allowed for CSRF (staging/preview URLs)
CSRF_ALLOWED_ORIGINS=""
# Comma-separated extra image hosts for CSP img-src
IMG_ALLOWED_HOSTS=""

# --- Set automatically by Next.js ---
# NODE_ENV: development | test | production
