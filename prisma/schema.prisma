// Alliance of Coders - production schema (PostgreSQL / Supabase).
// Prisma 7: the datasource URL is no longer in the schema. It lives in
// prisma.config.ts (for CLI) and is passed as an adapter to PrismaClient
// (for runtime). See prisma.config.ts and src/lib/db.ts.
//
// Supabase note: prisma db push / migrate do NOT work through PgBouncer
// transaction pooling (pooler port 6543). The config's datasource.url is
// set to DIRECT_URL when available (see prisma.config.ts). Runtime queries
// use DATABASE_URL (the pooler) directly via the adapter in src/lib/db.ts.
//
// Multi-schema: the database has a `profiles` table (dead code per ADR-0003)
// with a FK to `auth.users` (Supabase's managed auth schema). Prisma db push
// fails with P4002 if it can't introspect across schemas. Adding "auth" to
// schemas lets Prisma resolve the cross-schema reference. Our models are all
// in "public"; the auth schema is listed only so Prisma can introspect the
// FK without error. We do NOT model auth.users — it's managed by Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

model Announcement {
  id        String   @id
  type      String   @default("general")
  title     String
  body      String   @db.Text
  image     String?  @map("image_url")
  pinned    Boolean  @default(false)
  date      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([pinned])
  @@index([date(sort: Desc)])
  @@map("announcements")
  @@schema("public")
}

model AdminYear {
  id        String    @id @default(uuid()) @db.Uuid
  year      String    @unique
  theme     String    @default("Set a leadership theme for this year.")
  sortOrder Int       @default(0) @map("sort_order")
  officers  Officer[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("admin_years")
  @@schema("public")
}

model Officer {
  id        String    @id @default(uuid()) @db.Uuid
  yearId    String    @map("year_id") @db.Uuid
  name      String    @default("Vacant Slot")
  role      String    @default("Open Position")
  image     String?   @map("image_url")
  sortOrder Int       @default(0) @map("sort_order")
  year      AdminYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@index([yearId])
  @@index([sortOrder])
  @@map("officers")
  @@schema("public")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @unique @map("client_id")
  name      String
  email     String
  subject   String
  category  String   @default("General Inquiry")
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("contact_messages")
  @@schema("public")
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String?
  passwordHash String         @map("password_hash")
  role         String         @default("admin")
  sessions     AdminSession[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("admin_users")
  @@schema("public")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
  @@schema("public")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([entity])
  @@map("activity_logs")
  @@schema("public")
}
