// Alliance of Coders - development schema (SQLite).
// Used for local dev with DATABASE_URL=file:./db/custom.db.
// Prisma 7: the datasource URL is in prisma.config.ts (for CLI) and passed
// as an adapter to PrismaClient (for runtime). See src/lib/db.ts.
//
// Mirrors the production schema (schema.prisma) but uses SQLite types
// (no @db.Uuid, no @db.Text, no @map needed - SQLite is case-insensitive).
// Per 02-system-design.md: keep dev close to production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Announcement {
  id        String   @id
  type      String   @default("general")
  title     String
  body      String
  image     String?
  links     String   @default("")  // JSON-encoded array of {url, label} objects
  pinned    Boolean  @default(false)
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([pinned])
  @@index([date(sort: Desc)])
}

model AdminYear {
  id        String    @id @default(cuid())
  year      String    @unique
  theme     String    @default("Set a leadership theme for this year.")
  sortOrder Int       @default(0)
  officers  Officer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

model Officer {
  id        String   @id @default(cuid())
  yearId    String
  name      String   @default("Vacant Slot")
  role      String   @default("Open Position")
  image     String?
  sortOrder Int      @default(0)
  // Self-relation: who this officer reports to (org-chart hierarchy).
  // Nullable so legacy rows + vacant slots work without a parent. The API
  // validates the parent exists in the same year and rejects cycles.
  reportsToId String? @map("reports_to_id")
  reportsTo   Officer?  @relation("OfficerHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports Officer[] @relation("OfficerHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  year      AdminYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@index([yearId])
  @@index([sortOrder])
  @@index([reportsToId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  clientId  String   @unique
  name      String
  email     String
  subject   String
  category  String   @default("General Inquiry")
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         String        @default("admin")
  sessions     AdminSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AdminSession {
  id        String     @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
}

// Privacy-first page-view analytics. Per 06-security-architecture.md section 8
// (data minimization): we store a DAILY visitor hash (SHA-256 of IP + day),
// NEVER the raw IP. No cookies, no PII. The hash lets us count unique visitors
// per day without re-identifying a person across days. Per Z.md: no external
// analytics SDK — a ~60-line client beacon + this table. Per 05-ui-ux-design.md
// section 6: the beacon uses sendBeacon (non-blocking, survives navigation).
model PageView {
  id        String   @id @default(cuid())
  // SHA-256(ip + dateSalt): identifies a visitor within one day, not across
  // days. Nullable so a request with no forwarded IP still records a view.
  visitorHash String?
  path       String
  // Referrer DOMAIN only (strips query/path) to avoid storing inbound URLs
  // that may carry PII. Nullable for direct visits.
  referrer   String?
  // Coarse device class derived from User-Agent (mobile/tablet/desktop/bot).
  device     String?
  // ISO country code from the cf-ipcountry / x-vercel-ip-country header
  // (set by the edge gateway). Nullable when no header is present.
  country    String?
  // Anonymous per-session id generated client-side (random, in-memory only —
  // not persisted to a cookie) so we can group a single visit's views without
  // tracking a user across sessions.
  sessionId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorHash])
}