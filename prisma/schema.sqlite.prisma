generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Announcement {
  id        String   @id
  type      String   @default("general")
  title     String
  body      String
  image     String?
  links     String   @default("")  
  pinned    Boolean  @default(false)
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([pinned])
  @@index([date(sort: Desc)])
}

model AdminYear {
  id        String    @id @default(cuid())
  year      String    @unique
  theme     String    @default("Set a leadership theme for this year.")
  sortOrder Int       @default(0)
  officers  Officer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

model Officer {
  id        String   @id @default(cuid())
  yearId    String
  name      String   @default("Vacant Slot")
  role      String   @default("Open Position")
  image     String?
  sortOrder Int      @default(0)
  reportsToId String? @map("reports_to_id")
  reportsTo   Officer?  @relation("OfficerHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports Officer[] @relation("OfficerHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  year      AdminYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@index([yearId])
  @@index([sortOrder])
  @@index([reportsToId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  clientId  String   @unique
  name      String
  email     String
  subject   String
  category  String   @default("General Inquiry")
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model AdminUser {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String?
  passwordHash  String
  role          String              @default("admin")
  active        Boolean             @default(true)
  sessions      AdminSession[]
  mfaChallenges AdminMfaChallenge[]
  invitesCreated AdminInvite[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model AdminSession {
  id        String     @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminMfaChallenge {
  id          String    @id @default(cuid())
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  attempts    Int       @default(0)
  consumed    Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("admin")
  tokenHash   String    @unique
  createdBy   String
  creator     AdminUser @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([createdBy])
  @@index([expiresAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
}
model PageView {
  id        String   @id @default(cuid())
  visitorHash String?
  path       String
  referrer   String?
  device     String?
  country    String?
  sessionId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorHash])
}

model IntegrationConfig {
  id        String   @id
  enabled   Boolean  @default(false)
  config    String   @default("")
  secret    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}